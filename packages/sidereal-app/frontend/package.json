{
  "name": "sidereal-app-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "gen-api": "uv run python -m sidereal_app.api.openapi > openapi.json && openapi-typescript openapi.json --default-non-nullable=false -o src/lib/api-schema.d.ts",
    "lint": "eslint .",
    "check:typst": "npx tsx scripts/typst-text-check.ts"
  },
  "dependencies": {
    "@directus/sdk": "^25.0.1",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@tanstack/react-query": "^5.102.8",
    "lucide-react": "^1.45.0",
    "openapi-fetch": "^0.17.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.3",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0"
  }
}
