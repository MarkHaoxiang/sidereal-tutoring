          "tutor",
          "student"
        ],
        "title": "CallerRole"
      },
      "Document": {
        "properties": {
          "title": {
            "type": "string",
            "title": "Title"
          },
          "kind": {
            "$ref": "#/components/schemas/DocumentKind"
          },
          "source_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Url"
          },
          "file": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "File"
          },
          "text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Text"
          },
          "student": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Student"
          },
          "session": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Session"
          },
          "status": {
            "$ref": "#/components/schemas/DocumentStatus",
            "default": "pending"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "metadata": {
            "additionalProperties": true,
            "type": "object",
            "title": "Metadata"
          },
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "date_created": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Date Created"
          },
          "date_updated": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Date Updated"
          },
          "user_created": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "User Created"
          },
          "user_updated": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "User Updated"
          }
        },
        "type": "object",
        "required": [
          "title",
          "kind",
          "id"
        ],
        "title": "Document"
      },
      "DocumentKind": {
        "type": "string",
        "enum": [
          "transcript",
          "web_page",
          "question_bank",
          "upload"
        ],
        "title": "DocumentKind"
      },
      "DocumentRequest": {
        "properties": {
          "student_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Student Id"
          },
          "session_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id"
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          },
          "source": {
            "$ref": "#/components/schemas/DocumentSourceRequest"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "source"
        ],
        "title": "DocumentRequest"
      },
      "DocumentSourceRequest": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/FileSourceRequest"
          },
          {
            "$ref": "#/components/schemas/UrlSourceRequest"
          },
          {
            "$ref": "#/components/schemas/TextSourceRequest"
          }
        ],
        "discriminator": {
          "propertyName": "type",
          "mapping": {
            "file": "#/components/schemas/FileSourceRequest",
            "text": "#/components/schemas/TextSourceRequest",
            "url": "#/components/schemas/UrlSourceRequest"
          }
        }
      },
      "DocumentStatus": {
        "type": "string",
        "enum": [
          "pending",
          "processing",
          "ready",
          "failed"
        ],
        "title": "DocumentStatus"
      },
      "FileSourceRequest": {
        "properties": {
          "type": {
            "type": "string",
            "const": "file",
            "title": "Type"
          },
          "file_id": {
            "type": "string",
            "format": "uuid",
            "title": "File Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "type",
          "file_id"
        ],
        "title": "FileSourceRequest"
      },
      "GenerationJob": {
        "properties": {
          "kind": {
            "$ref": "#/components/schemas/GenerationKind"
          },
          "student": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Student"
          },
          "status": {
            "$ref": "#/components/schemas/JobStatus",
