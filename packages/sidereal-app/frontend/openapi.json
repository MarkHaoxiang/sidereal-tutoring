          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "password"
        ],
        "title": "PasswordRequest"
      },
      "StudentLogin": {
        "properties": {
          "user_id": {
            "type": "string",
            "format": "uuid",
