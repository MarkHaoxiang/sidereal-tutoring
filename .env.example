# Copy to .env before running docker compose. Dev-only values: this stack is intended to be
# reachable from localhost only, and every credential below is a placeholder, not a secret.
#   cp .env.example .env

# --- Postgres (read by the postgres service) -------------------------------------------
POSTGRES_USER=sidereal
POSTGRES_PASSWORD=sidereal
POSTGRES_DB=sidereal
POSTGRES_PORT=5432

# --- Directus database connection ------------------------------------------------------
DB_CLIENT=pg
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=sidereal
DB_USER=sidereal
DB_PASSWORD=sidereal

# --- Directus instance -----------------------------------------------------------------
# The Directus LICENSE_KEY is deliberately not set here. It is loaded from
# ~/.config/sidereal-tutoring/env into the invoking shell; see docs/development.md.
# KEY/SECRET are dev placeholders. Generate real random values for anything deployed.
KEY=dev-key-not-secret-0000000000000000
SECRET=dev-secret-not-secret-000000000000
PUBLIC_URL=http://localhost:8055
LOG_LEVEL=info

# Admin account created on first boot; also used by scripts/directus-bootstrap.sh.
ADMIN_EMAIL=admin@sidereal.example.com
ADMIN_PASSWORD=sidereal-dev

# Browser clients (the React frontend on Vite's default port).
CORS_ENABLED=true
CORS_ORIGIN=http://localhost:5173
CORS_CREDENTIALS=true

# --- Application ------------------------------------------------------------------------
SIDEREAL_DIRECTUS_URL=http://localhost:8055
# Printed by scripts/directus-bootstrap.sh.
SIDEREAL_DIRECTUS_TOKEN=
SIDEREAL_DATA_DIR=./data
# claude calls Anthropic; fake calls nothing and returns obviously-fake artefacts.
SIDEREAL_GENERATE_BACKEND=claude
SIDEREAL_GENERATE_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=

# --- Rust services -----------------------------------------------------------------------
SIDEREAL_TRANSCRIPTS_ADDR=127.0.0.1:50051
SIDEREAL_TRANSCRIPTS_POLL_SECS=30
